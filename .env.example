# PostgreSQL
POSTGRES_USER=cdrreader
POSTGRES_PASSWORD=cdrreader_secret_change_me
POSTGRES_DB=cdrreader
POSTGRES_PORT=5432

# Frontend / Nginx
FRONTEND_PORT=8080

# Timezone
TZ=Europe/Moscow

# Watch directory (auto-import)
WATCH_DIR_ENABLED=true
WATCH_POLL_INTERVAL=15

# Optional external SFTP Poller (if backend pulls files from remote SFTP)
SFTP_POLLER_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/cdr
SFTP_POLL_INTERVAL=60

# Optional built-in SFTP receiver (docker compose --profile sftp up -d)
SFTP_SERVER_USER=cucm_cdr
SFTP_SERVER_PASSWORD=cucm_cdr_secret
SFTP_SERVER_PORT=2222
