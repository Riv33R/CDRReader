# PostgreSQL
POSTGRES_USER=cdrreader
POSTGRES_PASSWORD=cdrreader_secret_change_me
POSTGRES_DB=cdrreader
POSTGRES_PORT=5432

# Frontend / Nginx
FRONTEND_PORT=8080

# Timezone
TZ=Europe/Moscow

# Call direction classification (digits <= this length are treated as internal extensions)
INTERNAL_NUMBER_MAX_LEN=6

# Watch directory (auto-import; set to /srv/cucm_sftp/cdr when using host sshd SFTP)
CDR_INBOX_DIR=./data/cdr_inbox
WATCH_DIR_ENABLED=true
WATCH_POLL_INTERVAL=15

# Optional external SFTP Poller (if backend pulls files from remote SFTP)
SFTP_POLLER_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/cdr
SFTP_POLL_INTERVAL=60

# Embedded FTP Server (receives incoming CDR/CMR push uploads from Cisco CUCM)
FTP_SERVER_ENABLED=true
FTP_PORT=21
FTP_SERVER_USER=cucm_ftp
FTP_SERVER_PASSWORD=cucm_secret_change_me
FTP_SERVER_PASV_MIN=21100
FTP_SERVER_PASV_MAX=21110
# Set this to the external IP or domain of this host if CUCM is behind NAT
FTP_SERVER_MASQUERADE_ADDRESS=
